name: Void Atmospheric Harvester
description: Uses cryogenic separation and atmospheric processing to collect nitrogen for advanced manufacturing.
type: AttributeCrafter
category: crafting
shownPlanets: [serpulo, erekir]

# Keeps full baseline production on ordinary terrain; Erekir steam vents add up to 25%.
attribute: steam
baseEfficiency: 1
minEfficiency: -1
boostScale: 0.0625
maxBoost: 0.25
# Attribute speed also scales continuous liquid inputs and power.
scaleLiquidConsumption: true

# Water and cryofluid are the two physical inputs.
size: 2
outputLiquid: nitrogen/1.6666667
# Liquid output is continuous: 1.6666667/tick = 100/second = 6000/minute.
craftTime: 120
liquidCapacity: 60

drawer: {
    type: DrawMulti
    drawers: [
        {
            type: DrawRegion
            # Shared 64x64 base used by the 2x2 liquid/gas producers.
            name: vanilla-cosmic-cosmic-liquid-bottom
        }
        {
            type: DrawLiquidTile
            drawLiquid: water
        }
        { type: DrawDefault }
        {
            type: DrawGlowRegion
            suffix: "-glow"
            color: ffffffff
            alpha: 1
            glowIntensity: 1
        }
    ]
}

hasLiquids: true
hasPower: true
flammabilityScale: 0.5
explosivenessScale: 0.5

# Crafting role: MH 1.162, MA 0.349, RH 1.10, RA 0.90.
health: 200
armor: 2

requirements: [
    copper/150
    lead/125
    graphite/80
    silicon/100
    titanium/110
    thorium/60
    plastanium/40
    surge-alloy/20
]

consumes: {
    # 4 power/second ÷ 60 ticks/second.
    power: 0.06666667
    # 0.1 water/tick = 6/second = 12 per 120-tick craft.
    liquids: [
        water/0.1
        # 0.05 cryofluid/tick = 3/second = 6 per 120-tick craft.
        cryofluid/0.05
    ]
}

research: protostar-extractor
researchCost: [
    copper/750
    lead/625
    graphite/400
    silicon/500
    titanium/550
    thorium/300
    plastanium/200
    surge-alloy/100
]
