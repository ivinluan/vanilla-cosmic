name: Cosmic III Drill
description: The 3rd version of drill from the COSMOS. Enhanced using thorium, it is much more efficient than Cosmic II Drill.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
shownPlanets: [serpulo, erekir]
size: 2
tier: 5
drillTime: 190 # 1.26 items/sec at full ore coverage
buildCostMultiplier: 1

health: 230
armor: 2

hasItems: true
itemCapacity: 100
hasLiquids: true
liquidCapacity: 40

requirements: [
    copper/210
    graphite/90
    silicon/60
    titanium/180
    thorium/180
]

consumes: {
    liquid: {
        liquid: water
        amount: 0.12
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 1.85

research: cosmic-ii-drill
researchCost: [
    copper/1050
    graphite/450
    silicon/300
    titanium/900
    thorium/900
]

drillEffect: circleColorSpark
drillEffectChance: 0.7
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        heatReactorSmoke
        smokePuff
        ventSteam
    ]
}
