name: Cosmic Drill
description: Also known as Cosmic I Drill. The 1st version of drill from the COSMOS. Enhanced using titanium, it is better than pneumatic drill.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
shownPlanets: [serpulo, erekir]
size: 2
tier: 4
drillTime: 300 # 0.80 items/sec at full ore coverage
buildCostMultiplier: 1

health: 220
armor: 1

hasItems: true
itemCapacity: 60
hasLiquids: true
liquidCapacity: 20

requirements: [
    copper/150
    graphite/60
    silicon/40
    titanium/130
]

consumes: {
    liquid: {
        liquid: water
        amount: 0.08
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 1.65

research: {
    root: true
    name: vanilla-cosmic
    planet: serpulo
    requiresUnlock: false
}
researchCost: [
    copper/750
    graphite/300
    silicon/200
    titanium/650
]

drillEffect: circleColorSpark
drillEffectChance: 0.8
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        heatReactorSmoke
        smokePuff
        ventSteam
    ]
}
