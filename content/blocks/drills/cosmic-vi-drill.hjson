name: Cosmic VI Drill
description: The 6th version of drill from the COSMOS. Fortified using surge alloy, it is stronger than Cosmic V Drill.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
shownPlanets: [serpulo, erekir]
size: 2
tier: 5
drillTime: 100 # 2.40 items/sec at full ore coverage
buildCostMultiplier: 1

health: 230
armor: 2

hasItems: true
itemCapacity: 160
hasLiquids: true
liquidCapacity: 70

requirements: [
    copper/300
    graphite/130
    silicon/90
    titanium/250
    thorium/250
    surge-alloy/20
]

consumes: {
    liquid: {
        liquid: water
        amount: 0.18
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 2.15

research: cosmic-v-drill
researchCost: [
    copper/1500
    graphite/650
    silicon/450
    titanium/1250
    thorium/1250
    surge-alloy/100
]

drillEffect: circleColorSpark
drillEffectChance: 0.55
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        heatReactorSmoke
        smokePuff
        ventSteam
    ]
}
