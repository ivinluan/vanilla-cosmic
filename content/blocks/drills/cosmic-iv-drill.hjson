name: Cosmic IV Drill
description: The 4th version of drill from the COSMOS. Fortified using phase fabric, it is stronger than Cosmic III Drill.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
size: 2
tier: 5
drillTime: 150 # 1.60 items/sec at full ore coverage
buildCostMultiplier: 1

health: 220
armor: 1

hasItems: true
itemCapacity: 120
hasLiquids: true
liquidCapacity: 50

requirements: [
    copper/240
    graphite/100
    silicon/70
    titanium/200
    phase-fabric/60
]

consumes: {
    liquid: {
        liquid: water
        amount: 0.14
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 1.95

research: cosmic-iii-drill
researchCost: [
    copper/1200
    graphite/500
    silicon/350
    titanium/1000
    phase-fabric/300
]

drillEffect: circleColorSpark
drillEffectChance: 0.65
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        heatReactorSmoke
        smokePuff
        ventSteam
    ]
}
