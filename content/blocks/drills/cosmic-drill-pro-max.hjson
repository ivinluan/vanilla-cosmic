name: Cosmic Drill Pro Max
description: This is the best drill from the COSMOS, it surpasses all existing drills. Uses cryofluid instead of water to further enhance its drilling speed.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
size: 4
tier: 5
drillTime: 42 # 22.86 items/sec at full ore coverage
buildCostMultiplier: 1

health: 840
armor: 1

hasItems: true
itemCapacity: 240
hasLiquids: true
liquidCapacity: 110
hasPower: true

requirements: [
    copper/780
    lead/780
    graphite/330
    silicon/250
    phase-fabric/200
    surge-alloy/40
]

consumes: {
    power: 0.43
    liquid: {
        liquid: cryofluid
        amount: 0.26
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 2.55

research: cosmic-drill-pro
researchCost: [
    copper/3900
    lead/3900
    graphite/1650
    silicon/1250
    phase-fabric/1000
    surge-alloy/200
]

rotateSpeed: 10
warmupSpeed: 0.1

drawRim: true

drillEffect: payloadReceive
drillEffectChance: 0.5
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        smokeCloud
        smokePuff
    ]
}
