name: Cosmic V Drill
description: The 5th version of drill from the COSMOS. Enhanced using beryllium, it is much more efficient than Cosmic IV Drill.
type: Drill
# Cosmic machinery halves stored-content fire and explosion effects.
flammabilityScale: 0.5
explosivenessScale: 0.5
category: production
shownPlanets: [serpulo, erekir]
size: 2
tier: 5
drillTime: 120 # 2.00 items/sec at full ore coverage
buildCostMultiplier: 1

health: 230
armor: 2

hasItems: true
itemCapacity: 140
hasLiquids: true
liquidCapacity: 60

requirements: [
    copper/270
    graphite/110
    silicon/80
    titanium/230
    thorium/230
    beryllium/230
]

consumes: {
    liquid: {
        liquid: water
        amount: 0.16
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 2.05

research: cosmic-iv-drill
researchCost: [
    copper/1350
    graphite/550
    silicon/400
    titanium/1150
    thorium/1150
    beryllium/1150
]

drillEffect: circleColorSpark
drillEffectChance: 0.6
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        heatReactorSmoke
        smokePuff
        ventSteam
    ]
}
