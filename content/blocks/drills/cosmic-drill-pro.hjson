name: Cosmic Drill Pro
description: This is the pro version of Cosmic Drill. Has more capacity and much faster than older Cosmic Drills. Uses cryofluid instead of water to further enhance its drilling speed.
type: Drill
category: production
size: 3
tier: 5
drillTime: 52 # 10.38 items/sec at full ore coverage
buildCostMultiplier: 1

health: 1040
armor: 1080

hasItems: true
itemCapacity: 220
hasLiquids: true
liquidCapacity: 100
hasPower: true

requirements: [
    copper/540
    lead/540
    graphite/230
    silicon/170
    titanium/450
    thorium/450
]

consumes: {
    power: 0.3
    liquid: {
        liquid: cryofluid
        amount: 0.24
        optional: true
        booster: true
    }
}
liquidBoostIntensity: 2.45

research: cosmic-viii-drill
researchCost: [
    copper/2700
    lead/2700
    graphite/1150
    silicon/850
    titanium/2250
    thorium/2250
]

drillEffect: payloadReceive
drillEffectChance: 0.5
updateEffect: {
    type: MultiEffect,
    effects: [
        drillSteam
        smokeCloud
        smokePuff
    ]
}
